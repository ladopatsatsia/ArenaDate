# DatingMVP Mobile Environment Variables

# API Gateway URL:
# - Local Android emulator: http://10.0.2.2:5180
# - Local iOS simulator: http://localhost:5180
# - Local physical phone: http://<your-lan-ip>:5180
# - Staging / Production: MUST be https:// (e.g. https://api.datingmvp.example.com)
EXPO_PUBLIC_API_URL=http://localhost:5180

# EAS Build Profile (development | preview | production)
EAS_BUILD_PROFILE=development

# Owner-provided IDs required for preview and production signed native builds:
IOS_BUNDLE_IDENTIFIER=com.datingmvp.app
ANDROID_APPLICATION_ID=com.datingmvp.app
EAS_PROJECT_ID=00000000-0000-0000-0000-000000000000

# Native build versioning:
IOS_BUILD_NUMBER=1
ANDROID_VERSION_CODE=1

# Universal Links / App Links associated domain (without protocol, e.g. api.datingmvp.example.com):
APP_ASSOCIATED_DOMAIN=api.datingmvp.example.com

# Android production build only: path to google-services.json (never commit credentials):
GOOGLE_SERVICES_JSON=./google-services.json
