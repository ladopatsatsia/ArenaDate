# .NET does not automatically load this file; set in the shell or user secrets.
ConnectionStrings__Database=Host=127.0.0.1;Port=55432;Database=dating;Username=dating;Password=replace-with-your-local-password
ASPNETCORE_ENVIRONMENT=Development
ASPNETCORE_URLS=http://localhost:5180

# Development: scripts/dev.ps1 prepares these with a persistent local-only key.
Auth__SigningKeyPem=<private-RSA-PEM-from-secret-storage>
Auth__KeyRingPath=<absolute-private-persistent-directory>
Auth__Issuer=DatingMVP
Auth__Audience=DatingMVP.Mobile
Email__Mode=Capture
Email__Host=127.0.0.1
Email__Port=1025
Email__Sender=no-reply@dating.local
# Production additionally requires a private key-ring protection certificate and SMTP.
# Auth__KeyCertificatePath=<private-PFX-path>
# Auth__KeyCertificatePassword=<secret>
# Email__Mode=Smtp
# Email__Host=<provider-host>
# Email__Port=587
# Email__Sender=<verified-sender>
# Email__Username=<secret>
# Email__Password=<secret>

# Private media: explicit local-only development storage.
Media__Mode=Local
Media__LocalPath=<absolute-private-directory>
Media__AutoApprove=false
# Production requires S3, with public access blocked on the bucket.
# Media__Mode=S3
# Media__Endpoint=https://<s3-compatible-endpoint>
# Media__Region=<region>
# Media__Bucket=<private-bucket>
# Media__AccessKey=<secret>
# Media__SecretKey=<secret>
